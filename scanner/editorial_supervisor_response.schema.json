{
  "type": "object",
  "required": ["reviewed_candidates", "recommended_ids"],
  "additionalProperties": true,
  "properties": {
    "recommended_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "reviewed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lead_id",
          "scanner_type",
          "agent_rating",
          "concise_reason",
          "mfo_angle",
          "evidence_risk",
          "archive_overlap_warning",
          "editorial_rank",
          "why_editorial_ranking_differs",
          "recommended_action"
        ],
        "properties": {
          "lead_id": { "type": "string" },
          "scanner_type": { "type": "string", "enum": ["creator", "news", "research", "manual"] },
          "agent_rating": { "type": "string", "enum": ["Strong", "Possible", "Weak"] },
          "concise_reason": { "type": "string" },
          "mfo_angle": { "type": "string" },
          "evidence_risk": { "type": "string" },
          "archive_overlap_warning": { "type": "string" },
          "editorial_rank": { "type": ["integer", "null"], "minimum": 1 },
          "why_editorial_ranking_differs": { "type": "string" },
          "recommended_action": { "type": "string", "enum": ["commission", "hold", "reject"] },
          "facts_to_check": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "excluded_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lead_id", "reason"],
        "properties": {
          "lead_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
